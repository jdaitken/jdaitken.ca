<IfModule mod_headers.c>
  # Static assets: cache for 30 days (filenames change rarely; bump query string to bust)
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML/PHP: always revalidate so content and pricing changes show immediately
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# 2026-10-31: www.jdaitken.ca served a duplicate copy (Google indexed www for /nepean-web-design/).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.jdaitken\.ca$ [NC]
  RewriteRule ^(.*)$ https://jdaitken.ca/$1 [R=301,L]
</IfModule>

# Superseded 2026-08-09: blog/index.html now exists, so /blog/ serves the catalog directly.
# RedirectMatch 302 ^/blog/?$ https://jdaitken.ca/blog/website-that-generates-calls-local-trades/
